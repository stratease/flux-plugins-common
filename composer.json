{
    "name": "stratease/flux-plugins-common",
    "description": "Shared library for Flux Plugins suite providing common services, React components, and infrastructure.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Flux Plugins",
            "email": "eddie@fluxplugins.com",
            "homepage": "https://fluxplugins.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "automattic/wordbless": "^0.4",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "FluxPlugins\\Common\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FluxPlugins\\Common\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "post-install-cmd": [
            "WorDBless\\Composer\\InstallDropin::copy"
        ],
        "post-update-cmd": [
            "WorDBless\\Composer\\InstallDropin::copy"
        ]
    },
    "bin": [
        "bin/build-plugin.sh",
        "bin/deploy-plugin.sh"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "roots/wordpress-core-installer": true
        }
    },
    "archive": {
        "exclude": [
            "node_modules",
            ".git",
            ".gitignore",
            "package.json",
            "package-lock.json",
            "webpack.config.js",
            "webpack.config.base.js",
            "webpack.config.helpers.js",
            "tests",
            "phpunit.xml.dist"
        ]
    }
}

